        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:success|info|error|warning)$/]",
        "message": "<Toast> state must be one of 'success' | 'info' | 'error' | 'warning'."
